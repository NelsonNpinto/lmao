# --- Backend (read by backend/app/config.py; all optional locally) ---
ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO
GIT_SHA=local                   # set by the build in deployed environments
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/windsight   # default: SQLite in data/
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_CHUNK_DAYS=7
ELEXON_CONCURRENCY=3
STUDY_FROM=2026-01-02           # first delivery day (inclusive)
STUDY_TO=2026-02-02             # end of delivery window (exclusive)
CUTOFF_LOCAL=09:00              # UK local time on D-1
MARGIN_QUANTILE=0.90
INSTALLED_CAPACITY_MW=30000
ALLOWED_ORIGINS=["http://localhost:3000"]
ADMIN_TOKEN=change-me           # required when ENV=prod

# --- Frontend (public, baked into the bundle; never put secrets here) ---
VITE_API_BASE_URL=              # empty = same origin via the dev proxy
VITE_API_PROXY_TARGET=http://localhost:8010
VITE_STATIC_SNAPSHOT=false     # true = run entirely from frontend/public/snapshot (no API)
